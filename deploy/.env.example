# ACME account email for Caddy certificates.
ACME_EMAIL=admin@example.com
# Postgres administrator password (initialization and emergency maintenance only).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Non-superuser database owner password; must match the connection string.
TORVELLO_APP_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Runtime database connection; never use postgres as the API user.
ConnectionStrings__Torvello=Host=postgres;Database=torvello;Username=torvello_app;Password=REPLACE_WITH_RANDOM_HEX
# At least 32 random bytes; rotating this invalidates JWTs.
Jwt__SigningKey=REPLACE_WITH_RANDOM_HEX
# Initial owner credentials; remove password after provisioning.
Bootstrap__OwnerEmail=owner@example.com
Bootstrap__OwnerPassword=REPLACE_WITH_RANDOM_HEX
Bootstrap__OwnerName=Owner
# Explicit browser origins, duplicated in Compose to fix production routing.
Cors__Origins__0=https://app.torvellobd.com
PublicSite__Origins__0=https://torvellobd.com
PublicSite__Origins__1=https://www.torvellobd.com
# Links in invite/reset emails.
AppLinks__WebBaseUrl=https://app.torvellobd.com
# Durable unencrypted keys; back up this volume securely.
DataProtection__KeysPath=/data/keys
# Must match Compose subnet; only Caddy is an intended proxy.
ForwardedHeaders__KnownNetworks__0=172.30.80.0/24
# Pickup writes emails to a folder inside the container until an SMTP service exists.
# Switch to Smtp (STARTTLS) and fill the Smtp values to deliver invite/reset emails.
Email__Provider=Pickup
Email__FromAddress=no-reply@torvellobd.com
Email__FromName=Torvello
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUser=REPLACE_ME
Email__SmtpPassword=REPLACE_ME
# Used only while Provider is Pickup.
Email__PickupDirectory=/tmp/mail-pickup
